{
  "name": "animer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "wrangler pages dev public --port 8788 --persist-to .wrangler/state",
    "test:pipeline": "node scripts/test-pipeline.mjs",
    "test:playback": "node --test tests/playback.test.mjs tests/watch-playback.test.mjs tests/history.test.mjs tests/play-proxy.test.mjs",
    "report": "node scripts/summarize-report.mjs",
    "check:api": "node scripts/check-functions.mjs",
    "db:local": "wrangler d1 migrations apply animer-db --local --persist-to .wrangler/state",
    "db:remote": "wrangler d1 migrations apply animer-db --remote",
    "build": "vite build && node scripts/copy-legal.mjs && node scripts/build-access-helper.mjs",
    "preview": "vite preview",
    "build-only": "vite build && node scripts/copy-legal.mjs && node scripts/build-access-helper.mjs",
    "type-check": "vue-tsc --build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run type-check && npm run type-check:worker && npm test && npm run check:api && npm run build && npm run check:pages",
    "type-check:worker": "tsc -p tsconfig.worker.json",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "access-helper": "node scripts/build-access-helper.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "danmaku": "^2.0.10",
    "hls.js": "^1.5.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@playwright/test": "^1.64.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "AGPL-3.0-only"
}
